{
  "name": "@stockmandigital/automessage-mcp",
  "version": "0.2.0",
  "description": "MCP server for autoMessage \u2014 gives Claude, Codex, and any MCP client the ability to send iMessages, read conversation history, manage drafts, and resolve contacts via the autoMessage REST API.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "automessage-mcp": "dist/stdio.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/stdio.js",
    "start:http": "node dist/http.js",
    "dev": "tsx watch src/stdio.ts",
    "dev:http": "tsx watch src/http.ts",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^8.0.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "imessage",
    "claude",
    "claude-code",
    "automessage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexstockman1/automessage-mcp.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://automessage.app",
  "bugs": {
    "url": "https://github.com/alexstockman1/automessage-mcp/issues"
  },
  "author": "Stockman Digital, LLC"
}
